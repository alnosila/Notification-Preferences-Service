{
  "name": "notification-preferences-service",
  "version": "1.0.0",
  "author": "alnosila (https://github.com/alnosila)",
  "description": "Notification Preferences Service — single source of truth for notification delivery preferences",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/infrastructure/persistence/migrate.ts",
    "db:seed": "tsx src/infrastructure/persistence/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "setup": "npm run infra:up && tsx src/infrastructure/persistence/wait-for-db.ts && npm run db:setup",
    "encrypt": "bash scripts/encrypt.sh",
    "decrypt": "bash scripts/decrypt.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "luxon": "^3.6.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
